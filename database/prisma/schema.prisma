generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DONOR
  PATIENT
  HOSPITAL
  BLOOD_BANK
  ADMIN
}

enum BloodGroup {
  O_NEGATIVE
  O_POSITIVE
  A_NEGATIVE
  A_POSITIVE
  B_NEGATIVE
  B_POSITIVE
  AB_NEGATIVE
  AB_POSITIVE
}

enum AvailabilityStatus {
  AVAILABLE
  TEMPORARILY_UNAVAILABLE
  INACTIVE
}

enum RequestStatus {
  OPEN
  MATCHED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  EXPIRED
}

enum EmergencyPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DonationStatus {
  PLEDGED
  SCHEDULED
  COMPLETED
  DECLINED
  CANCELLED
}

enum MatchStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum NotificationType {
  SYSTEM
  EMERGENCY_REQUEST
  MATCH_UPDATE
  REQUEST_STATUS
  DONATION_REMINDER
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  role         Role
  fullName     String
  phone        String?
  city         String?
  state        String?
  country      String?
  isActive     Boolean         @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  donorProfile   DonorProfile?
  patientProfile PatientProfile?
  hospital       Hospital?
  bloodBank      BloodBank?
  bloodRequests  BloodRequest[] @relation("RequestCreator")
  notifications  Notification[]
  auditLogs      AuditLog[]     @relation("ActorAuditLogs")

  @@index([role])
  @@index([city, state])
}

model DonorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  bloodGroup         BloodGroup
  locationLabel      String
  latitude           Decimal?           @db.Decimal(9, 6)
  longitude          Decimal?           @db.Decimal(9, 6)
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  lastDonationDate   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  donations       Donation[]
  donorMatches    DonorMatch[]

  @@index([bloodGroup, availabilityStatus])
}

model PatientProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  bloodGroup     BloodGroup?
  locationLabel  String
  latitude       Decimal?      @db.Decimal(9, 6)
  longitude      Decimal?      @db.Decimal(9, 6)
  emergencyNotes String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodRequests BloodRequest[]
}

model Hospital {
  id              String         @id @default(cuid())
  userId          String         @unique
  name            String
  registrationId  String         @unique
  locationLabel   String
  latitude        Decimal?       @db.Decimal(9, 6)
  longitude       Decimal?       @db.Decimal(9, 6)
  contactNumber   String
  emergencyContact String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodRequests BloodRequest[]
  donations     Donation[]

  @@index([name])
}

model BloodBank {
  id             String           @id @default(cuid())
  userId         String           @unique
  name           String
  licenseNumber  String           @unique
  locationLabel  String
  latitude       Decimal?         @db.Decimal(9, 6)
  longitude      Decimal?         @db.Decimal(9, 6)
  contactNumber  String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventories     BloodInventory[]
  bloodRequests   BloodRequest[]

  @@index([name])
}

model BloodRequest {
  id               String            @id @default(cuid())
  requesterUserId  String
  patientProfileId String?
  hospitalId       String?
  bloodBankId      String?
  bloodGroup       BloodGroup
  unitsRequired    Int
  unitsFulfilled   Int               @default(0)
  locationLabel    String
  latitude         Decimal?          @db.Decimal(9, 6)
  longitude        Decimal?          @db.Decimal(9, 6)
  priority         EmergencyPriority @default(MEDIUM)
  status           RequestStatus     @default(OPEN)
  requiredBy       DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  cancelledAt      DateTime?

  requester     User            @relation("RequestCreator", fields: [requesterUserId], references: [id], onDelete: Restrict)
  patient       PatientProfile? @relation(fields: [patientProfileId], references: [id], onDelete: SetNull)
  hospital      Hospital?       @relation(fields: [hospitalId], references: [id], onDelete: SetNull)
  bloodBank     BloodBank?      @relation(fields: [bloodBankId], references: [id], onDelete: SetNull)
  donations     Donation[]
  donorMatches  DonorMatch[]

  @@index([status, priority])
  @@index([bloodGroup, status])
  @@index([hospitalId])
  @@index([bloodBankId])
}

model Donation {
  id                  String         @id @default(cuid())
  donorProfileId      String
  bloodRequestId      String?
  donatedToHospitalId String?
  unitsDonated        Int
  status              DonationStatus @default(PLEDGED)
  scheduledAt         DateTime?
  donatedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  donorProfile DonorProfile @relation(fields: [donorProfileId], references: [id], onDelete: Restrict)
  bloodRequest BloodRequest? @relation(fields: [bloodRequestId], references: [id], onDelete: SetNull)
  hospital     Hospital?     @relation(fields: [donatedToHospitalId], references: [id], onDelete: SetNull)

  @@index([donorProfileId, status])
  @@index([bloodRequestId])
}

model BloodInventory {
  id            String     @id @default(cuid())
  bloodBankId   String
  bloodGroup    BloodGroup
  unitsAvailable Int
  updatedByUserId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  bloodBank   BloodBank @relation(fields: [bloodBankId], references: [id], onDelete: Cascade)

  @@unique([bloodBankId, bloodGroup])
  @@index([bloodGroup])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}

model DonorMatch {
  id            String      @id @default(cuid())
  bloodRequestId String
  donorProfileId String
  compatibilityScore Float
  distanceKm     Float?
  rankingReason  Json?
  status         MatchStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  respondedAt    DateTime?

  bloodRequest BloodRequest @relation(fields: [bloodRequestId], references: [id], onDelete: Cascade)
  donorProfile DonorProfile @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)

  @@unique([bloodRequestId, donorProfileId])
  @@index([bloodRequestId, compatibilityScore])
  @@index([donorProfileId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorUserId String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}
