generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DONOR
  PATIENT
  HOSPITAL
  BLOOD_BANK
  ADMIN
}

enum RequestStatus {
  PENDING
  MATCHING
  DONOR_CONTACTED
  FULFILLED
  CANCELLED
}

enum EmergencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  REQUEST_CREATED
  REQUEST_UPDATED
  DONOR_MATCHED
  EMERGENCY_ALERT
  DONATION_REMINDER
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  phone          String?         @unique
  passwordHash   String
  role           UserRole
  isActive       Boolean         @default(true)
  isVerified     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  donorProfile   DonorProfile?
  patientProfile PatientProfile?
  hospital       Hospital?
  bloodBank      BloodBank?
  notifications  Notification[]
  auditLogs      AuditLog[]
  bloodRequests  BloodRequest[]  @relation("UserRequests")
  passwordResetTokens PasswordResetToken[]

  @@index([role])
}

model DonorProfile {
  id                 String     @id @default(cuid())
  userId             String     @unique
  fullName           String
  bloodGroup         String
  locationLat        Decimal?
  locationLng        Decimal?
  contactVisibility  Boolean    @default(false)
  availabilityStatus Boolean    @default(true)
  dateOfBirth        DateTime?
  lastDonationDate   DateTime?
  verificationStatus Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  donations          Donation[]
  matches            Match[]

  @@index([bloodGroup, availabilityStatus])
}

model PatientProfile {
  id        String         @id @default(cuid())
  userId    String         @unique
  fullName  String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests  BloodRequest[] @relation("PatientRequests")
}

model Hospital {
  id            String         @id @default(cuid())
  userId        String         @unique
  name          String
  address       String
  locationLat   Decimal?
  locationLng   Decimal?
  contactNumber String
  verified      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bloodRequests BloodRequest[]

  @@index([verified])
}

model BloodBank {
  id            String           @id @default(cuid())
  userId        String           @unique
  name          String
  address       String
  locationLat   Decimal?
  locationLng   Decimal?
  contactNumber String
  verified      Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventories   BloodInventory[]

  @@index([verified])
}

model BloodRequest {
  id               String          @id @default(cuid())
  requesterUserId  String
  patientProfileId String?
  hospitalId       String?
  bloodGroup       String
  requiredUnits    Int
  locationLat      Decimal?
  locationLng      Decimal?
  hospitalName     String?
  requiredDate     DateTime
  emergencyLevel   EmergencyLevel  @default(MEDIUM)
  contactInfo      String
  additionalInfo   String?
  status           RequestStatus   @default(PENDING)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  requester        User            @relation("UserRequests", fields: [requesterUserId], references: [id], onDelete: Cascade)
  patientProfile   PatientProfile? @relation("PatientRequests", fields: [patientProfileId], references: [id])
  hospital         Hospital?       @relation(fields: [hospitalId], references: [id])
  matches          Match[]

  @@index([bloodGroup, status])
  @@index([emergencyLevel, requiredDate])
  @@index([patientProfileId])
}

model Donation {
  id             String       @id @default(cuid())
  donorProfileId String
  requestId      String?
  donatedAt      DateTime     @default(now())
  units          Int
  notes          String?
  createdAt      DateTime     @default(now())
  donorProfile   DonorProfile @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)

  @@index([donorProfileId, donatedAt])
}

model BloodInventory {
  id          String    @id @default(cuid())
  bloodBankId String
  bloodGroup  String
  units       Int
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bloodBank   BloodBank @relation(fields: [bloodBankId], references: [id], onDelete: Cascade)

  @@unique([bloodBankId, bloodGroup])
  @@index([bloodGroup, units])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Match {
  id             String       @id @default(cuid())
  requestId      String
  donorProfileId String
  score          Float
  rank           Int
  reason         String?
  createdAt      DateTime     @default(now())
  request        BloodRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  donorProfile   DonorProfile @relation(fields: [donorProfileId], references: [id], onDelete: Cascade)

  @@unique([requestId, donorProfileId])
  @@index([requestId, rank])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, action])
  @@index([createdAt])
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
